rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /cafeUsers/{playerId} {
      allow read, write: if true;
    }
    match /rankings/{playerId} {
      allow read, write: if true;
    }
    match /cafeNames/{nameKey} {
      allow read, write: if true;
    }
  }
}
